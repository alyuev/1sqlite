    {"Item","1sqlite","Рыба: остатки + обороты","","Начало + обороты + конец (UNION ALL)","",
"@Шаблон:
-- Остаток на начало (из итогов) + обороты за месяц (из движений) + остаток на конец.
Select strftime('%Y%m%d', date(Period,'+1 months')) as Period, <Измерения>, 0 as Doc,
       Sum(СуммаОсн) as Сумма
From РегистрИтоги_<Имя>
Where Period between '<нач.прошлого мес>' and '<нач.текущего мес>'
Group by Period, <Измерения>
Union All  -- обороты за текущий месяц
Select strftime('%Y%m%d', date(Date,'start of month')) as Period, <Измерения>, 0 as Doc,
       Sum(Case When DEBKRED=1 Then -СуммаОсн Else СуммаОсн End) as Сумма
From Регистр_<Имя>
Where Date between '<нач.мес>' and '<кон.дата>'
Group by Period, <Измерения>"
    },
